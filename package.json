{
  "name": "astro-sarkara",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:package": "turbo run build --filter='./packages/*'",
    "lint": "turbo run lint --filter='./app/*' --filter='./packages/*' && eslint --config packages/eslint-config/import-resolution.mjs app packages",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "npm run build:package && changeset publish",
    "format": "prettier \"packages/**/src/**/*.{js,ts,cjs,mjs,astro}\" --write",
    "lint-staged": "lint-staged",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@repo/typescript-config": "*",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-turbo": "^2.11.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.87.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@12.2.0"
}
