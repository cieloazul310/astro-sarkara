{
  "name": "@cieloazul310/astro-sarkara",
  "description": "Core package of astro-sarkara, including Astro components and layout built with Panda CSS.",
  "version": "2.3.0",
  "license": "ISC",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "require": "./dist/preset.cjs",
      "import": "./dist/preset.mjs"
    }
  },
  "files": [
    "src/index.ts",
    "dist"
  ],
  "keywords": [
    "astro",
    "pandacss"
  ],
  "author": {
    "name": "cieloazul310",
    "email": "cieloazul310@gmail.com",
    "url": "https://cieloazul310.github.io"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cieloazul310/astro-sarkara.git",
    "directory": "packages/core"
  },
  "scripts": {
    "tsdown": "tsdown",
    "dev": "npm run tsdown -- --watch",
    "build": "npm run clean && npm run tsdown",
    "lint": "oxlint",
    "clean": "git clean -fx .turbo/ dist/"
  },
  "dependencies": {
    "@cieloazul310/astro-sarkara-components": "^6.1.0",
    "@cieloazul310/astro-sarkara-layout": "^6.1.0",
    "@cieloazul310/astro-sarkara-utils": "^2.3.0",
    "@cieloazul310/panda-preset-sarkara-base": "^2.3.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.1.1",
    "@pandacss/preset-base": "^2.1.1",
    "@pandacss/preset-panda": "^2.1.1",
    "@repo/typescript-config": "^1.2.0"
  },
  "peerDependencies": {
    "@pandacss/dev": "^1.0.0 || ^2.0.0",
    "@pandacss/preset-base": "^1.0.0 || ^2.0.0",
    "@pandacss/preset-panda": "^1.0.0 || ^2.0.0",
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,ts}": [
      "oxlint --fix",
      "prettier --write"
    ]
  }
}
