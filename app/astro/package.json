    "rehype-class-names": "^2.0.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/partytown": "^2.1.8",
    "@pandacss/dev": "^2.1.1",
    "@pandacss/vite": "^2.1.1",
    "@repo/eslint-config": "^1.2.0",
    "eslint": "^10.12.0"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,ts}": [
