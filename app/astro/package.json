    "panda": "panda",
    "check": "astro check",
    "lint": "oxlint && eslint \"src/**/*.astro\""
  },
  "dependencies": {
    "@cieloazul310/astro-sarkara": "^2.2.0",
    "@iconify-json/mdi": "^1.2.3",
