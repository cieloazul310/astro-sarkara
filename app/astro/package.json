{
  "name": "astro-app",
  "private": true,
  "type": "module",
  "version": "1.2.0",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "panda codegen && astro build",
    "preview": "astro preview",
